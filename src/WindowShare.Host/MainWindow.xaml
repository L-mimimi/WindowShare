<Window x:Class="WindowShare.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗享 Host - 屏幕共享（只读）"
        Width="980" Height="720"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- 顶部：共享控制 -->
        <GroupBox Grid.Row="0" Header="共享控制">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第 1 行：共享源 + 开始/停止 -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="共享源：" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Left" x:Name="CboSources" Width="340" Margin="4"
                              SelectionChanged="Source_SelectionChanged"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnToggleShare" Width="120" Margin="8,0"
                            Background="#1E88E5" Foreground="White" FontWeight="Bold"
                            Content="开始共享" Click="BtnToggleShare_Click"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkRecord" Content="编码验证(写H.264)"
                              VerticalAlignment="Center" Margin="8,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkAudio" Content="共享系统声音" IsChecked="True"
                              VerticalAlignment="Center" Margin="8,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTip="共享本机正在播放的声音（游戏/视频/音乐/系统提示音），不是麦克风。&#10;开始共享后修改不生效，需停止后重新开始。&#10;没有播放设备或没有 AAC 编码器时会自动降级为纯视频共享。"/>
                </DockPanel>

                <!-- 第 2 行：分辨率（最高 4K）+ 帧率档位 + 自动码率 -->
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="分辨率：" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Left" x:Name="CboResolution" Width="180" Margin="4"
                              SelectionChanged="Quality_SelectionChanged"/>
                    <TextBlock DockPanel.Dock="Left" Text="帧率：" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox DockPanel.Dock="Left" x:Name="CboFps" Width="90" Margin="4"
                              SelectionChanged="Quality_SelectionChanged"/>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtBitrateHint" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="#666"/>
                </DockPanel>

                <!-- 第 3 行：信令服务器（房间号模式）；失败不影响局域网共享 -->
                <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,6,0,0">
                    <CheckBox DockPanel.Dock="Left" x:Name="ChkSignaling" Content="信令服务器（房间号模式）"
                              VerticalAlignment="Center" IsChecked="False"
                              Checked="ChkSignaling_Changed" Unchecked="ChkSignaling_Changed"/>
                    <TextBlock DockPanel.Dock="Left" Text="地址：" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox DockPanel.Dock="Left" x:Name="TxtSignalingUrl" Width="220" Margin="4"
                             Text="http://localhost:5000" ToolTip="形如 http://主机:5000；跨网段观看才需要"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnSignalingRetry" Content="重试" Padding="10,2"
                            Margin="4,0" Click="BtnSignalingRetry_Click" Visibility="Collapsed"
                            ToolTip="重新连接信令服务器并注册房间（不影响正在进行的局域网共享）"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkDiscoverable" Content="局域网发现"
                              VerticalAlignment="Center" Margin="8,0"
                              ToolTip="共享期间向局域网广播本机名称与端口（不含密码），观看端可自动发现并一键直连"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkMinToTray" Content="关闭时隐藏到托盘"
                              VerticalAlignment="Center" Margin="8,0"
                              ToolTip="共享进行中点关闭按钮 → 隐藏到通知栏继续共享；不勾选则直接停止共享"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtSignalingState" Text="未启用" Foreground="#888"
                               VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="380"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- 中部：预览 -->
        <Border Grid.Row="1" Background="#111" Margin="6" CornerRadius="4">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <TextBlock x:Name="TxtPreviewHint" Text="选择共享源后点击「开始共享」" Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 会话信息 -->
        <GroupBox Grid.Row="2" Header="会话信息">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="房间号：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRoomCode" Width="90" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="密码：" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPassword" Width="90" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold"/>
                    <Button x:Name="BtnCopy" Content="复制邀请" Click="BtnCopy_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtEncoder" Text="编码器：未启动" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtOutput" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#666" ToolTip="实际编码输出（受源尺寸与动态分辨率约束，可能低于所选档位）"/>
                    <TextBlock x:Name="TxtAudio" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#666" ToolTip="系统声音共享状态与实时电平"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtStats" Text="观看者：0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnStop" Content="⏹ 一键停止" Margin="20,0,0,0" Click="BtnStop_Click"
                            Background="#E53935" Foreground="White" FontWeight="Bold" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtMode" Text="" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#1E88E5" ToolTip="当前数据存放位置（便携模式跟随程序目录）"/>
                    <Button x:Name="BtnDataDir" Content="📁" Padding="8,2" Click="BtnDataDir_Click"
                            ToolTip="打开数据目录（日志 / 白名单 / 录制文件）"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 底部：日志 -->
        <GroupBox Grid.Row="3" Header="日志">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="11" Background="#FAFAFA"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
