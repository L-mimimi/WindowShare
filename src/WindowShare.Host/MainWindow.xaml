<Window x:Class="WindowShare.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗享 Host - 屏幕共享（只读）"
        Width="980" Height="720"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- 顶部：共享控制 -->
        <GroupBox Grid.Row="0" Header="共享控制">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="共享源：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboSources" Width="380" Margin="4"/>
                        <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="画质：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboQuality" Width="150" Margin="4" SelectionChanged="CboQuality_SelectionChanged"/>
                    </StackPanel>
                    <CheckBox Grid.Column="3" x:Name="ChkRecord" Content="编码验证(写H.264)" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Grid.Column="4" x:Name="BtnToggleShare" Width="120" Margin="8,0"
                            Background="#1E88E5" Foreground="White" FontWeight="Bold"
                            Content="开始共享" Click="BtnToggleShare_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="ChkSignaling" Content="信令服务器（房间号模式）" VerticalAlignment="Center" IsChecked="False"/>
                    <TextBlock Text="地址：" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="TxtSignalingUrl" Width="220" Text="http://localhost:5000" Margin="4"/>
                    <TextBlock x:Name="TxtSignalingState" Text="未启用" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 中部：预览 -->
        <Border Grid.Row="1" Background="#111" Margin="6" CornerRadius="4">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <TextBlock x:Name="TxtPreviewHint" Text="选择共享源后点击「开始共享」" Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 会话信息 -->
        <GroupBox Grid.Row="2" Header="会话信息">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="房间号：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRoomCode" Width="90" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="密码：" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPassword" Width="90" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold"/>
                    <Button x:Name="BtnCopy" Content="复制邀请" Click="BtnCopy_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtEncoder" Text="编码器：未启动" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtStats" Text="观看者：0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnStop" Content="⏹ 一键停止" Margin="20,0,0,0" Click="BtnStop_Click"
                            Background="#E53935" Foreground="White" FontWeight="Bold" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtMode" Text="" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#1E88E5" ToolTip="当前数据存放位置（便携模式跟随程序目录）"/>
                    <Button x:Name="BtnDataDir" Content="📁" Padding="8,2" Click="BtnDataDir_Click"
                            ToolTip="打开数据目录（日志 / 白名单 / 录制文件）"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 底部：日志 -->
        <GroupBox Grid.Row="3" Header="日志">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="11" Background="#FAFAFA"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
