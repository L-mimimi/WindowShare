<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host 共享端：捕获源选择、预览、悬浮提示、一键停止 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WindowShare.Host</RootNamespace>
    <AssemblyName>WindowShare.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowShare.Core\WindowShare.Core.csproj" />
  </ItemGroup>

</Project>
