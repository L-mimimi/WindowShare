<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host 共享端：捕获源选择、预览、悬浮提示、一键停止 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WindowShare.Host</RootNamespace>
    <AssemblyName>WindowShare.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/windowshare.ico</ApplicationIcon>
    <!-- 共享端是高吞吐生产者（捕获/编码/分发），服务器 GC 减少 gen2 阻塞毛刺 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowShare.Core\WindowShare.Core.csproj" />
  </ItemGroup>

  <!-- 托盘图标（TrayIcon 从程序集内嵌资源解析，避免 System.Drawing 依赖） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\windowshare.ico" LogicalName="WindowShare.Host.tray.ico" />
  </ItemGroup>

</Project>
