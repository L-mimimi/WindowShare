<Window x:Class="WindowShare.Host.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="观看者请求接入" Width="420" Height="220"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="⚠ 有设备请求观看您的屏幕" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="以下设备希望通过房间密码连接（只读观看）：" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtDevice" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtDeviceId" Foreground="#666" FontSize="11" Margin="0,0,0,14"/>
        <TextBlock Text="如果您不认识该设备，请选择「拒绝」。" Foreground="#E53935" FontSize="11" Margin="0,0,0,12"/>
        <TextBlock x:Name="TxtCountdown" Foreground="#888" FontSize="11" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="拒绝" Click="BtnDeny_Click" Width="90" Background="#EEE"/>
            <Button Content="仅本次允许" Click="BtnOnce_Click" Width="110"/>
            <Button Content="允许并记住" Click="BtnRemember_Click" Width="110" FontWeight="Bold"
                    Background="#43A047" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
