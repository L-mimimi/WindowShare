<Window x:Class="WindowShare.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗享 Viewer - 只读观看"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接面板：两种模式各自独立的输入区，只有当前模式的输入框可用 -->
        <GroupBox Grid.Row="0" Header="连接">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbDirect" GroupName="ConnMode" IsChecked="True" VerticalAlignment="Center"
                                 Content="直连 IP（同一局域网）" Checked="ConnMode_Checked"/>
                    <RadioButton x:Name="RbRoom" GroupName="ConnMode" Margin="24,0,0,0" VerticalAlignment="Center"
                                 Content="房间号（经信令服务器，可跨网段）" Checked="ConnMode_Checked"/>
                </StackPanel>

                <!-- 直连模式：地址 + 端口 + 密码 -->
                <DockPanel x:Name="PanelDirect" LastChildFill="False" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Host 地址：" VerticalAlignment="Center"/>
                    <TextBox DockPanel.Dock="Left" x:Name="TxtHost" Width="150" Margin="4" Text="127.0.0.1"/>
                    <TextBlock DockPanel.Dock="Left" Text="端口：" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox DockPanel.Dock="Left" x:Name="TxtPort" Width="70" Margin="4" Text="48750"/>
                    <TextBlock DockPanel.Dock="Left" Text="密码：" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <PasswordBox DockPanel.Dock="Left" x:Name="TxtPwd" Width="130" Margin="4"/>
                </DockPanel>

                <!-- 房间号模式：房间号 + 密码 + 信令服务器 -->
                <DockPanel x:Name="PanelRoom" LastChildFill="False" Margin="0,8,0,0" IsEnabled="False">
                    <TextBlock DockPanel.Dock="Left" Text="房间号：" VerticalAlignment="Center"/>
                    <TextBox DockPanel.Dock="Left" x:Name="TxtRoom" Width="110" Margin="4"/>
                    <TextBlock DockPanel.Dock="Left" Text="密码：" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <PasswordBox DockPanel.Dock="Left" x:Name="TxtRoomPwd" Width="130" Margin="4"/>
                    <TextBlock DockPanel.Dock="Left" Text="信令服务器：" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox DockPanel.Dock="Left" x:Name="TxtSignaling" Width="230" Margin="4"
                             Text="http://localhost:5000"/>
                </DockPanel>

                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Left" x:Name="BtnConnect" Content="连接" Width="100" FontWeight="Bold"
                            Background="#1E88E5" Foreground="White" Click="BtnConnect_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Left" x:Name="BtnDisconnect" Content="断开" Width="80" Margin="8,0,0,0"
                            Click="BtnDisconnect_Click" IsEnabled="False"/>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtModeHint" VerticalAlignment="Center"
                               Margin="16,0,0,0" Foreground="#888"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- 视频区 -->
        <Border Grid.Row="1" Background="#0A0A0A" Margin="6" CornerRadius="4">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform"/>
                <TextBlock x:Name="TxtPlaceholder" Text="输入房间号或直连地址开始观看" Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F2F2F2" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtState" Text="状态：未连接" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtTransport" Text="传输：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtBitrate" Text="码率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtFps" Text="帧率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtLatency" Text="延迟：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtResolution" Text="分辨率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtEncoder" Text="编码器：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtEncrypt" Text="加密：-"/>
                <TextBlock x:Name="TxtMode" Text="" Margin="18,0,0,0" Foreground="#1E88E5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
