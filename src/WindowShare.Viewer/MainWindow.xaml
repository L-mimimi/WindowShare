<Window x:Class="WindowShare.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗享 Viewer - 只读观看"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接面板 -->
        <GroupBox Grid.Row="0" Header="连接">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbRoom" Content="房间号" IsChecked="False" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRoom" Width="80" Margin="4"/>
                    <TextBlock Text="密码" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRoomPwd" Width="90" Margin="4"/>
                    <TextBlock Text="信令" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSignaling" Width="160" Margin="4" Text="http://localhost:5000"/>
                    <RadioButton x:Name="RbDirect" Content="直连 IP" IsChecked="True" Margin="16,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHost" Width="130" Margin="4" Text="127.0.0.1" TextChanged="ModeChanged"/>
                    <TextBlock Text="端口" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPort" Width="60" Margin="4" Text="48750"/>
                    <TextBlock Text="密码" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtPwd" Width="90" Margin="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnConnect" Content="连接" Width="90" FontWeight="Bold"
                            Background="#1E88E5" Foreground="White" Click="BtnConnect_Click"/>
                    <Button x:Name="BtnDisconnect" Content="断开" Width="80" Click="BtnDisconnect_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 视频区 -->
        <Border Grid.Row="1" Background="#0A0A0A" Margin="6" CornerRadius="4">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform"/>
                <TextBlock x:Name="TxtPlaceholder" Text="输入房间号或直连地址开始观看" Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F2F2F2" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtState" Text="状态：未连接" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtTransport" Text="传输：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtBitrate" Text="码率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtFps" Text="帧率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtLatency" Text="延迟：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtResolution" Text="分辨率：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtEncoder" Text="编码器：-" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtEncrypt" Text="加密：-"/>
                <TextBlock x:Name="TxtMode" Text="" Margin="18,0,0,0" Foreground="#1E88E5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
