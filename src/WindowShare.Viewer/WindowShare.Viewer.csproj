<Project Sdk="Microsoft.NET.Sdk">

  <!-- Viewer 观看端：连接、解码显示、统计 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WindowShare.Viewer</RootNamespace>
    <AssemblyName>WindowShare.Viewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/windowshare.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowShare.Core\WindowShare.Core.csproj" />
  </ItemGroup>

</Project>
